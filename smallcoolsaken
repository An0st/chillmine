local function getBlockButton()
	if not MainUI then return nil end
	local container = MainUI:FindFirstChild("AbilityContainer")
	if not container then return nil end
	return container:FindFirstChild("Block") or container:FindFirstChild("Guard")
end

local function pressBlock()
	local btn = getBlockButton()
	if not btn then return false end
	local cd = btn:FindFirstChild("CooldownTime")
	if cd and cd.Text ~= "" then return false end
	pcall(function() btn:Activate() end)
	for _, conn in ipairs(getconnections(btn.MouseButton1Click) or {}) do
		pcall(function() conn:Fire() end)
	end
	return true
end

local function CreateBlockHitboxVisual()
	local part = Instance.new("Part")
	part.Name = "AttackHitboxVisual"
	part.Size = _G.BaseHitboxSize * _G.HitboxScale
	part.Color = _G.HitboxColor
	part.Material = Enum.Material.ForceField
	part.Transparency = 1 - _G.HitboxTransparency
	part.Anchored = true
	part.CanCollide = false
	part.CastShadow = false
	part.Parent = Hitboxes
	if _G.ShowOutline then
		local outline = Instance.new("SelectionBox")
		outline.Adornee = part
		outline.Color3 = _G.HitboxColor
		outline.LineThickness = _G.OutlineThickness
		outline.Transparency = 0.1
		outline.Visible = _G.ShowHitboxVisual
		outline.Parent = part
	end
	return part
end

local function UpdateBlockHitboxPosition(part, queryHitbox)
	if part and queryHitbox then
		part.CFrame = queryHitbox.CFrame * CFrame.new(0, _G.HitboxYOffset, _G.HitboxOffset)
		part.Size = _G.BaseHitboxSize * _G.HitboxScale
		part.Color = _G.HitboxColor
		part.Transparency = 1 - _G.HitboxTransparency
		local outline = part:FindFirstChildOfClass("SelectionBox")
		if outline then
			outline.Color3 = _G.HitboxColor
			outline.LineThickness = _G.OutlineThickness
			outline.Visible = _G.ShowOutline and _G.ShowHitboxVisual
		end
	end
end

local function ClearKillerBlockHitbox(Killer)
	local data = _G.BlockHitboxData[Killer]
	if data then
		if data.visualPart then data.visualPart:Destroy() end
		if data.visualConnection then data.visualConnection:Disconnect() end
		if data.heartbeatConnection then data.heartbeatConnection:Disconnect() end
		_G.BlockHitboxData[Killer] = nil
	end
end

local OverlapParams = OverlapParams.new()
OverlapParams.MaxParts = 1
OverlapParams.FilterType = Enum.RaycastFilterType.Include

local function StartBlockDetection(Killer, queryHitbox)
	ClearKillerBlockHitbox(Killer)
	local visualPart = CreateBlockHitboxVisual()
	UpdateBlockHitboxPosition(visualPart, queryHitbox)
	local visualConnection = RunService.Heartbeat:Connect(function()
		if visualPart and visualPart.Parent and queryHitbox and queryHitbox.Parent then
			UpdateBlockHitboxPosition(visualPart, queryHitbox)
		else
			visualConnection:Disconnect()
		end
	end)
	local data = {
		visualPart = visualPart,
		visualConnection = visualConnection,
		heartbeatConnection = nil
	}
	_G.BlockHitboxData[Killer] = data
	local localChar = lp.Character
	if not localChar or not SurvivorsFolder or localChar.Parent ~= SurvivorsFolder then
		task.delay(_G.HitboxDuration, function() ClearKillerBlockHitbox(Killer) end)
		return
	end
	local localQuery = localChar:FindFirstChild("QueryHitbox")
	if not localQuery then
		task.delay(_G.HitboxDuration, function() ClearKillerBlockHitbox(Killer) end)
		return
	end
	local hitboxSize = _G.BaseHitboxSize * _G.HitboxScale
	local startTime = tick()
	local instantPart = Instance.new("Part")
	instantPart.Size = hitboxSize
	instantPart.CanCollide = false
	instantPart.Anchored = true
	instantPart.Transparency = 1
	instantPart.Parent = Hitboxes
	local heartbeatPart = Instance.new("Part")
	heartbeatPart.Size = hitboxSize
	heartbeatPart.CanCollide = false
	heartbeatPart.Anchored = true
	heartbeatPart.Transparency = 1
	heartbeatPart.Parent = Hitboxes
	OverlapParams.FilterDescendantsInstances = { localQuery }
	instantPart.CFrame = queryHitbox.CFrame * CFrame.new(0, _G.HitboxYOffset, _G.HitboxOffset)
	local instantHits = Workspace:GetPartsInPart(instantPart, OverlapParams)
	if #instantHits > 0 then
		pressBlock()
		instantPart:Destroy()
		heartbeatPart:Destroy()
		ClearKillerBlockHitbox(Killer)
		return
	end
	local heartbeatConn
	heartbeatConn = RunService.Heartbeat:Connect(function()
		if not _G.AutoBlockEnabled then
			heartbeatConn:Disconnect()
			instantPart:Destroy()
			heartbeatPart:Destroy()
			ClearKillerBlockHitbox(Killer)
			return
		end
		if tick() - startTime > _G.HitboxDuration then
			heartbeatConn:Disconnect()
			instantPart:Destroy()
			heartbeatPart:Destroy()
			ClearKillerBlockHitbox(Killer)
			return
		end
		if not localChar.Parent or not SurvivorsFolder or localChar.Parent ~= SurvivorsFolder then
			heartbeatConn:Disconnect()
			instantPart:Destroy()
			heartbeatPart:Destroy()
			ClearKillerBlockHitbox(Killer)
			return
		end
		if not queryHitbox or not queryHitbox.Parent then
			heartbeatConn:Disconnect()
			instantPart:Destroy()
			heartbeatPart:Destroy()
			ClearKillerBlockHitbox(Killer)
			return
		end
		heartbeatPart.CFrame = queryHitbox.CFrame * CFrame.new(0, _G.HitboxYOffset, _G.HitboxOffset)
		local hits = Workspace:GetPartsInPart(heartbeatPart, OverlapParams)
		if #hits > 0 then
			pressBlock()
			heartbeatConn:Disconnect()
			instantPart:Destroy()
			heartbeatPart:Destroy()
			ClearKillerBlockHitbox(Killer)
		end
	end)
	data.heartbeatConnection = heartbeatConn
end

local function HandleKiller_Attribute(Killer)
	if not Players:GetPlayerFromCharacter(Killer) then return end
	local queryHitbox = Killer:FindFirstChild("QueryHitbox")
	if not queryHitbox then return end
	local abilityConn
	local function doBlock()
		if not _G.AutoBlockEnabled then return end
		StartBlockDetection(Killer, queryHitbox)
	end
	abilityConn = Killer:GetAttributeChangedSignal("AbilityLastUsed"):Connect(function()
		if not _G.AutoBlockEnabled then return end
		doBlock()
	end)
	Killer.AncestryChanged:Connect(function()
		if not Killer.Parent then
			abilityConn:Disconnect()
			ClearKillerBlockHitbox(Killer)
		end
	end)
	table.insert(_G.AutoBlockConnections, {
		Disconnect = function() abilityConn:Disconnect() end
	})
end

local function EnableAutoBlock()
	if _G.AutoBlockEnabled then
		for _, con in ipairs(_G.AutoBlockConnections) do
			pcall(con.Disconnect, con)
		end
		_G.AutoBlockConnections = {}
		GetObjects()
		if KillersFolder then
			for _, killer in ipairs(KillersFolder:GetChildren()) do
				HandleKiller_Attribute(killer)
			end
			local childCon = KillersFolder.ChildAdded:Connect(HandleKiller_Attribute)
			table.insert(_G.AutoBlockConnections, {
				Disconnect = function() childCon:Disconnect() end
			})
		end
	end
end

local function DisableAutoBlock()
	if not _G.AutoBlockEnabled then
		for _, con in ipairs(_G.AutoBlockConnections) do
			pcall(con.Disconnect, con)
		end
		_G.AutoBlockConnections = {}
		for killer, data in pairs(_G.BlockHitboxData) do
			if data.visualPart then data.visualPart:Destroy() end
			if data.visualConnection then data.visualConnection:Disconnect() end
			if data.heartbeatConnection then data.heartbeatConnection:Disconnect() end
		end
		_G.BlockHitboxData = {}
	end
end

