local function SaveConfig()
	pcall(function()
		local data = {
			infEnabled = infEnabled,
			espEnabled = espEnabled,
			showItems = showItems,
			showGen = showGen,
			jumpEnabled = jumpEnabled,
			sprintSpeed = stamina.SprintSpeed,
			hakariKey = hakariKey.Name,
			solveKey = solveKey.Name,
			autoBlock = _G.AutoBlockEnabled,
			showHitbox = _G.ShowHitboxVisual,
			hitboxScale = _G.HitboxScale,
			hitboxOffset = _G.HitboxOffset,
			hitboxDuration = _G.HitboxDuration,
		}
		writefile(CONFIG_FILE, HttpService:JSONEncode(data))
	end)
end

local function LoadConfig()
	pcall(function()
		if not isfile(CONFIG_FILE) then return end
		local data = HttpService:JSONDecode(readfile(CONFIG_FILE))
		if data.infEnabled ~= nil then infEnabled = data.infEnabled end
		if data.espEnabled ~= nil then espEnabled = data.espEnabled end
		if data.showItems ~= nil then showItems = data.showItems end
		if data.showGen ~= nil then showGen = data.showGen end
		if data.jumpEnabled ~= nil then jumpEnabled = data.jumpEnabled end
		if data.sprintSpeed then stamina.SprintSpeed = data.sprintSpeed end
		if data.hakariKey then pcall(function() hakariKey = Enum.KeyCode[data.hakariKey] end) end
		if data.solveKey then pcall(function() solveKey = Enum.KeyCode[data.solveKey] end) end
		if data.autoBlock ~= nil then _G.AutoBlockEnabled = data.autoBlock end
		if data.showHitbox ~= nil then _G.ShowHitboxVisual = data.showHitbox end
		if data.hitboxScale then _G.HitboxScale = data.hitboxScale end
		if data.hitboxOffset then _G.HitboxOffset = data.hitboxOffset end
		if data.hitboxDuration then _G.HitboxDuration = data.hitboxDuration end
	end)
end

LoadConfig()

