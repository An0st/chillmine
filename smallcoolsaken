-- ESP helpers
local PlayersFolder = workspace:WaitForChild("Players")

local oldLighting = {
	Ambient = Lighting.Ambient,
	OutdoorAmbient = Lighting.OutdoorAmbient,
	Brightness = Lighting.Brightness,
	FogStart = Lighting.FogStart,
	FogEnd = Lighting.FogEnd
}

local function FullBright(b)
	if b then
		Lighting.Ambient = Color3.new(1, 1, 1)
		Lighting.OutdoorAmbient = Color3.new(1, 1, 1)
		Lighting.Brightness = 6
		Lighting.FogStart = 0
		Lighting.FogEnd = 1000000
	else
		for k, v in pairs(oldLighting) do
			Lighting[k] = v
		end
	end
end

local function addHL(model, color)
	if not model or not model.Parent then return end
	local existing = model:FindFirstChild("ESP_HL")
	if existing then
		existing.FillColor = color
		existing.OutlineColor = color
		return
	end
	local h = Instance.new("Highlight")
	h.Name = "ESP_HL"
	h.FillTransparency = 0.85
	h.OutlineTransparency = 0
	h.FillColor = color
	h.OutlineColor = color
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = model
end

local function removeHL(model)
	local h = model and model:FindFirstChild("ESP_HL")
	if h then
		h:Destroy()
	end
end

local function ClearAllESP()
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("Highlight") and v.Name == "ESP_HL" then
			v:Destroy()
		end
	end
end

-- Main ESP loop (không chớp)
task.spawn(function()
	while task.wait(0.8) do
		-- Players
		if espEnabled then
			if PlayersFolder:FindFirstChild("Killers") then
				for _, v in ipairs(PlayersFolder.Killers:GetChildren()) do
					if v:FindFirstChild("Humanoid") then
						addHL(v, Color3.fromRGB(255, 0, 0))
					end
				end
			end
			if PlayersFolder:FindFirstChild("Survivors") then
				for _, v in ipairs(PlayersFolder.Survivors:GetChildren()) do
					if v:FindFirstChild("Humanoid") then
						addHL(v, Color3.fromRGB(0, 255, 0))
					end
				end
			end
		else
			if PlayersFolder:FindFirstChild("Killers") then
				for _, v in ipairs(PlayersFolder.Killers:GetChildren()) do
					removeHL(v)
				end
			end
			if PlayersFolder:FindFirstChild("Survivors") then
				for _, v in ipairs(PlayersFolder.Survivors:GetChildren()) do
					removeHL(v)
				end
			end
		end

		-- Items
		if showItems then
			for _, i in ipairs(workspace:GetDescendants()) do
				if i.Name == "Medkit" or i.Name == "BloxyCola" then
					addHL(i, Color3.fromRGB(180, 0, 255))
				end
			end
		else
			for _, i in ipairs(workspace:GetDescendants()) do
				if i.Name == "Medkit" or i.Name == "BloxyCola" then
					removeHL(i)
				end
			end
		end

		-- Generators
		if showGen then
			for _, g in ipairs(workspace:GetDescendants()) do
				if g.Name:lower():find("generator") then
					addHL(g, Color3.fromRGB(255, 255, 0))
				end
			end
		else
			for _, g in ipairs(workspace:GetDescendants()) do
				if g.Name:lower():find("generator") then
					removeHL(g)
				end
			end
		end
	end
end)

-- Hakari Dance
local hakariActive = false
local function ToggleHakariDance(state)
	local char = lp.Character
	if not char then return end
	local humanoid = char:FindFirstChildOfClass("Humanoid")
	local rootPart = char:FindFirstChild("HumanoidRootPart")
	if not humanoid or not rootPart then return end

	if state then
		hakariActive = true
		humanoid.PlatformStand = true
		humanoid.JumpPower = 0

		local bodyVelocity = Instance.new("BodyVelocity")
		bodyVelocity.Name = "HakariBV"
		bodyVelocity.MaxForce = Vector3.new(100000, 100000, 100000)
		bodyVelocity.Velocity = Vector3.zero
		bodyVelocity.Parent = rootPart

		local animation = Instance.new("Animation")
		animation.AnimationId = "rbxassetid://138019937280193"
		local animationTrack = humanoid:LoadAnimation(animation)
		animationTrack:Play()

		local sound = Instance.new("Sound")
		sound.Name = "HakariSound"
		sound.SoundId = "rbxassetid://87166578676888"
		sound.Parent = rootPart
		sound.Volume = 0.5
		sound.Looped = true
		sound:Play()

		pcall(function()
			local effect = ReplicatedStorage.Assets.Emotes.HakariDance.HakariBeamEffect:Clone()
			effect.Name = "PlayerEmoteVFX"
			effect.CFrame = char.PrimaryPart.CFrame * CFrame.new(0, -1, -0.3)
			effect.WeldConstraint.Part0 = char.PrimaryPart
			effect.WeldConstraint.Part1 = effect
			effect.Parent = char
			effect.CanCollide = false
		end)

		pcall(function()
			local args = {"PlayEmote", "Animations", "HakariDance"}
			ReplicatedStorage.Modules.Network.RemoteEvent:FireServer(unpack(args))
		end)

		animationTrack.Stopped:Connect(function()
			if not hakariActive then
				humanoid.PlatformStand = false
				local bv = rootPart:FindFirstChild("HakariBV")
				if bv then bv:Destroy() end
			end
		end)
	else
		hakariActive = false
		humanoid.PlatformStand = false
		humanoid.JumpPower = 50

		local bv = rootPart:FindFirstChild("HakariBV")
		if bv then bv:Destroy() end

		local sound = rootPart:FindFirstChild("HakariSound")
		if sound then
			sound:Stop()
			sound:Destroy()
		end

		local effect = char:FindFirstChild("PlayerEmoteVFX")
		if effect then effect:Destroy() end

		for _, track in ipairs(humanoid:GetPlayingAnimationTracks()) do
			if track.Animation.AnimationId == "rbxassetid://138019937280193" then
				track:Stop()
			end
		end
	end
end

