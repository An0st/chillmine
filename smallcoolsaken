local function addHL(model, color)
	if not model or not model.Parent then return end
	local ex = model:FindFirstChild("ESP_HL")
	if ex then ex.FillColor = color ex.OutlineColor = color return end
	local h = Instance.new("Highlight")
	h.Name = "ESP_HL"
	h.FillTransparency = 0.85
	h.OutlineTransparency = 0
	h.FillColor = color
	h.OutlineColor = color
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = model
end
local function removeHL(model)
	local h = model and model:FindFirstChild("ESP_HL")
	if h then h:Destroy() end
end
local function ClearAllESP()
	for _, v in ipairs(workspace:GetDescendants()) do
		if v:IsA("Highlight") and v.Name == "ESP_HL" then v:Destroy() end
	end
end

